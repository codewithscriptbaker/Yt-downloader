# Copy to .env and adjust for your environment

# Redis
REDIS_URL=redis://redis:6379/0

# Storage
STORAGE_PATH=/data/storage
FILE_TTL_SECONDS=3600
DISK_USAGE_LIMIT_MB=20480
MAX_FILE_SIZE_MB=500
MAX_DURATION_SECONDS=3600
JOB_TIMEOUT_SECONDS=600

# Abuse controls
MAX_JOBS_PER_IP=2
MAX_JOBS_PER_IP_PER_HOUR=10
ALLOWED_DOMAINS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,music.youtube.com,tiktok.com,www.tiktok.com,vm.tiktok.com,instagram.com,www.instagram.com

# Signed downloads — change in production
DOWNLOAD_SIGNING_SECRET=change-me-to-a-long-random-string
DOWNLOAD_URL_TTL_SECONDS=300

# CAPTCHA (Cloudflare Turnstile). Set CAPTCHA_ENABLED=true for public launch.
CAPTCHA_ENABLED=false
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=
NEXT_PUBLIC_CAPTCHA_ENABLED=false
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Frontend public URL bases (leave empty when served via Nginx on same origin)
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_BASE=

# CORS (direct API access during local dev)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1

# Worker
CELERY_CONCURRENCY=2
LOG_LEVEL=INFO

# Nginx host port
HTTP_PORT=80
