# Copy to .env at repo root and adjust for your environment.
#
# Local terminal workflow (run_all.py / uvicorn + npm):
#   REDIS_URL=redis://localhost:6379/0
#   NEXT_PUBLIC_API_BASE=http://localhost:8009
#   NEXT_PUBLIC_WS_BASE=ws://localhost:8009
#   CORS_ORIGINS includes http://localhost:3005
#
# Docker Compose + Nginx (same origin):
#   REDIS_URL=redis://redis:6379/0
#   NEXT_PUBLIC_API_BASE=  (empty)
#   NEXT_PUBLIC_WS_BASE=   (empty)

# Ports (scripts/run_all.py)
DUKTOO_API_PORT=8009
DUKTOO_FRONTEND_PORT=3005
DUKTOO_REDIS_CONTAINER=yt-redis
DUKTOO_START_SLEEP=4

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_PATH=./data/storage
FILE_TTL_SECONDS=3600
DISK_USAGE_LIMIT_MB=20480
MAX_FILE_SIZE_MB=500
MAX_DURATION_SECONDS=3600
JOB_TIMEOUT_SECONDS=600
DOWNLOAD_RETRY_ATTEMPTS=5
DOWNLOAD_RETRY_BACKOFF_SECONDS=3
DOWNLOAD_NETWORK_RETRIES=5

# Abuse controls
MAX_JOBS_PER_IP=2
MAX_JOBS_PER_IP_PER_HOUR=10
MAX_PLAYLIST_ENTRIES=30
MAX_PLAYLIST_SELECT=5
ALLOWED_DOMAINS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,music.youtube.com,tiktok.com,www.tiktok.com,vm.tiktok.com,instagram.com,www.instagram.com,facebook.com,www.facebook.com,m.facebook.com,mbasic.facebook.com,web.facebook.com,fb.watch,www.fb.watch,fb.com,www.fb.com

# Optional: server-side cookies.txt for Instagram/Facebook reliability.
# Export cookies from a logged-in browser (e.g. "Get cookies.txt LOCALLY" extension)
# while viewing facebook.com, save the file on the server, and point here.
# Never commit real cookies. Rotate when the session expires.
# Example: YTDLP_COOKIES_FILE=./secrets/cookies.txt
# YTDLP_COOKIES_FILE=
# YTDLP_PROXY=
FACEBOOK_SOCKET_TIMEOUT=60
TIKTOK_SOCKET_TIMEOUT=60

# Signed downloads — change in production
DOWNLOAD_SIGNING_SECRET=change-me-to-a-long-random-string
DOWNLOAD_URL_TTL_SECONDS=300

# Auth (optional accounts)
AUTH_JWT_SECRET=change-me-auth-secret

# CAPTCHA (Cloudflare Turnstile). Set CAPTCHA_ENABLED=true for public launch.
CAPTCHA_ENABLED=false
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=
NEXT_PUBLIC_CAPTCHA_ENABLED=false
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Frontend → backend (local). Leave empty under Nginx same-origin.
NEXT_PUBLIC_API_BASE=http://localhost:8009
NEXT_PUBLIC_WS_BASE=ws://localhost:8009

# CORS (must include your frontend origin)
CORS_ORIGINS=http://localhost:3005,http://localhost:3000,http://127.0.0.1:3005,http://127.0.0.1:3000

# Worker
CELERY_CONCURRENCY=2
LOG_LEVEL=INFO

# Nginx host port (docker compose)
HTTP_PORT=80
